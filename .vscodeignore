# VSCode Extension 打包忽略文件

# 源代码文件
src/**
tsconfig.json
.eslintrc.json

# 开发依赖
node_modules/**
.vscode/**
.vscode-test/**

# 测试文件
test-files/**
**/*.test.ts
**/*.test.js

# 构建和临时文件
*.vsix
.DS_Store
Thumbs.db

# Git 相关
.git/**
.gitignore
.gitattributes

# 文档和说明（保留 README.md）
USAGE.md
CHANGELOG.md
.github/**

# 开发工具配置
.eslintrc.*
.prettierrc.*
.editorconfig

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE 文件
.idea/**
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 备份文件
*.bak
*.backup
*.tmp

# SVG 图标文件（如果不需要）
media/icon.svg
